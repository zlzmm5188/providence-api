# Providence API 环境配置

[APP]
DEBUG = true
APP_TRACE = false

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = providence
USERNAME = root
PASSWORD = your_password
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = 
DEBUG = true

[REDIS]
HOST = 127.0.0.1
PORT = 6379
PASSWORD = 
SELECT = 0

[JWT]
SECRET = please_change_this_to_random_string
TTL = 7200
REFRESH_TTL = 86400

[SECURITY]
API_SIGN_KEY = your_api_sign_key
ENABLE_SIGN = false

[SYSTEM]
WITHDRAW_FEE_CNY = 10
WITHDRAW_FEE_USDT = 5
TRIAL_FUND_AMOUNT = 888
TRIAL_FUND_DAYS = 7
RIBAO_RATE_CNY = 0.0002
RIBAO_RATE_USDT = 0.0003
