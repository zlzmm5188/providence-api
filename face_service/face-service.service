# Providence 人脸比对服务 - Systemd 配置
#
# 安装步骤：
# 1. 复制此文件到 systemd 目录：
#    sudo cp face-service.service /etc/systemd/system/
#
# 2. 重新加载 systemd：
#    sudo systemctl daemon-reload
#
# 3. 启动服务：
#    sudo systemctl start face-service
#
# 4. 设置开机启动：
#    sudo systemctl enable face-service
#
# 5. 查看状态：
#    sudo systemctl status face-service
#
# 6. 查看日志：
#    sudo journalctl -u face-service -f

[Unit]
Description=Providence Face Verification Service
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/api.4kp3l0iq.top/face_service
Environment="PATH=/www/wwwroot/api.4kp3l0iq.top/face_service/venv/bin:/usr/local/bin:/usr/bin"
ExecStart=/www/wwwroot/api.4kp3l0iq.top/face_service/venv/bin/uvicorn main:app --host 0.0.0.0 --port 9000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
