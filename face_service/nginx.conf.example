# Providence 人脸比对服务 - Nginx 反向代理配置
#
# 将此配置添加到 api.4kp3l0iq.top 的 Nginx server 块中
# 路径通常为: /www/server/panel/vhost/nginx/api.4kp3l0iq.top.conf
#
# 添加后执行: nginx -t && nginx -s reload

# ========== 人脸比对服务代理 ==========
location /face/ {
    proxy_pass http://127.0.0.1:9000;
    proxy_http_version 1.1;

    # 请求头
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    # 超时设置（人脸识别可能需要较长时间）
    proxy_connect_timeout 60s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;

    # 文件上传大小限制
    client_max_body_size 20M;

    # 禁用缓冲（实时响应）
    proxy_buffering off;

    # 错误处理
    proxy_intercept_errors on;
    error_page 502 503 504 = @face_service_error;
}

# 人脸服务错误处理
location @face_service_error {
    default_type application/json;
    return 503 '{"code": -1, "msg": "人脸识别服务暂时不可用，请稍后重试", "data": null}';
}

# ========== 完整配置示例 ==========
# 以下是完整的 server 块配置参考：
#
# server {
#     listen 443 ssl http2;
#     server_name api.4kp3l0iq.top;
#
#     ssl_certificate /path/to/cert.pem;
#     ssl_certificate_key /path/to/key.pem;
#
#     # PHP 应用
#     location / {
#         # ... 现有的 PHP 配置 ...
#     }
#
#     # 人脸比对服务
#     location /face/ {
#         proxy_pass http://127.0.0.1:9000;
#         # ... 上面的配置 ...
#     }
# }
